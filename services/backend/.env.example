OLLAMA_DEFAULT_MODEL=gemma4:12b
OLLAMA_EMBED_MODEL=nomic-embed-text:latest

# Defaults
DEFAULT_PROVIDER=gemini
DEFAULT_GEMINI_MODEL=gemini-2.5-flash
DEFAULT_GROQ_MODEL=llama-3.3-70b-versatile
